# Wafilow Environment Configuration

# Database
# Use an external PostgreSQL connection for Vercel
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="your_production_secret"
NEXTAUTH_URL="https://wafilow.vercel.app" # Update this once deployed

# Meta App Configuration
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_CONFIG_ID="your_embedded_signup_config_id"

# Webhooks
META_VERIFY_TOKEN="your_custom_webhook_verify_token"
META_API_VERSION="v20.0"

# --- DEVELOPMENT / TEST MODE OVERRIDES ---
# (Omit these in production to rely on DB credentials for Embedded Signup)
WHATSAPP_TEST_PHONE_NUMBER_ID=""
WHATSAPP_TEST_WABA_ID=""
WHATSAPP_ACCESS_TOKEN=""
