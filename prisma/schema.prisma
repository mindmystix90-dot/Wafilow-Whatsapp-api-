generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  role                String               @default("user")
  status              String               @default("active")
  sessionVersion      Int                  @default(1)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([role, status])
  @@index([organizationId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                  String                    @id @default(cuid())
  name                String                    @default("Default Organization")
  status              String                    @default("active") // "active" | "suspended"
  planTier            String                    @default("starter") // "free" | "starter" | "growth" | "pro" | "enterprise"
  monthlyLimit        Int?                      // Custom override limit. If null, defaults to PLAN_LIMITS[planTier]
  wabaId              String?                   @unique
  phoneNumberId       String?                   @unique
  displayPhoneNumber  String?
  accessToken         String?
  webhookVerifyToken  String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  users               User[]
  contacts            Contact[]
  conversations       Conversation[]
  messages            Message[]
  wabaAccounts        WhatsAppBusinessAccount[]
  whatsappConnections WhatsAppConnection[]

  @@index([status])
  @@index([planTier])
}

model WhatsAppConnection {
  id                 String    @id @default(cuid())
  organizationId     String
  environment        String    @default("production") // "production" | "sandbox"
  wabaId             String?
  phoneNumberId      String?
  displayPhoneNumber String?
  verifiedName       String?
  accessToken        String? // Encrypted using AES-256-GCM via lib/crypto.ts
  status             String    @default("disconnected") // "connected" | "disconnected" | "error"
  lastCheckedAt      DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, environment])
  @@index([phoneNumberId])
  @@index([wabaId])
}

model WhatsAppBusinessAccount {
  id             String                @id @default(cuid())
  organizationId String
  wabaId         String                @unique
  name           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumbers   WhatsAppPhoneNumber[]
}

model WhatsAppPhoneNumber {
  id            String                   @id @default(cuid())
  wabaAccountId String?
  phoneNumberId String                   @unique
  displayPhone  String?
  verifiedName  String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  wabaAccount   WhatsAppBusinessAccount? @relation(fields: [wabaAccountId], references: [id], onDelete: Cascade)
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String?
  environment    String         @default("production") // "production" | "sandbox"
  name           String
  phoneNumber    String         @unique
  waId           String?
  tags           String?
  status         String         @default("active")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  messages       Message[]
  conversations  Conversation[]

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model Conversation {
  id             String   @id @default(cuid())
  contactId      String
  organizationId String?
  environment    String   @default("production") // "production" | "sandbox"
  status         String   @default("open") // "open" | "closed"
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model Template {
  id        String   @id @default(cuid())
  name      String
  category  String
  language  String   @default("en_US")
  status    String   @default("APPROVED")
  body      String
  createdAt DateTime @default(now())
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  templateId  String?
  status      String    @default("draft")
  scheduledAt DateTime?
  sentCount   Int       @default(0)
  totalCount  Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Message {
  id             String   @id @default(cuid())
  contactId      String
  organizationId String?
  environment    String   @default("production") // "production" | "sandbox"
  wamId          String?  @unique
  direction      String // "inbound" | "outbound"
  content        String
  type           String   @default("text")
  status         String   @default("sent") // "sent" | "delivered" | "read" | "failed"
  errorMessage   String?
  timestamp      DateTime @default(now())

  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String   // e.g. "USER_STATUS_CHANGE", "ORGANIZATION_STATUS_CHANGE", "QUOTA_OVERRIDE_UPDATE"
  targetType String   // "USER" | "ORGANIZATION" | "QUOTA" | "SUBSCRIPTION" | "SYSTEM"
  targetId   String
  details    String?  // JSON stringified payload
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hash of plaintext token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

